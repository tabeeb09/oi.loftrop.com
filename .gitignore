# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# cv
/public/pdfs/cv.pdf

# NavBar iterations
/components/VerticalNavBar.tsx
/components/VerticalNavBar (1).tsx
/components/VerticalNavBar (1).css

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.tar
*.tar.zip

