# Public hostnames
APP_HOST=app.example.com
MEDIA_HOST=media.example.com
RUSTFS_ADMIN_HOST=rustfs-admin.example.com
OAUTH2_PROXY_HOST=oauth2.example.com

# Public URLs
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com
NEXTAUTH_URL=https://app.example.com

# RustFS / S3
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=https://media.example.com
STORAGE_PROJECT=portfolio
S3_BUCKET=public-media
S3_PUBLIC_BUCKET=public-media
S3_PRIVATE_BUCKET=private-user-files
S3_PROJECT_KEY_PREFIX=
S3_PUBLIC_KEY_PREFIX=
S3_PRIVATE_KEY_PREFIX=
NEXT_PUBLIC_MEDIA_BUCKET=public-media
NEXT_PUBLIC_MEDIA_KEY_PREFIX=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# File storage provider: local, s3, or supabase
FILE_STORAGE_PROVIDER=s3

# Supabase-backed private user file storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=user-files
FILE_UPLOAD_MAX_BYTES=262144000
FILE_ALLOWED_MIME_TYPES=
FILE_ALLOWED_EXTENSIONS=3mf,stl,obj,step,stp,iges,igs,ply,amf,gcode
KEYCLOAK_FILE_UPLOAD_LIMIT_CLAIMS=file_upload_limit_bytes,fileUploadLimitBytes
KEYCLOAK_FILE_ADMIN_ROLES=owner,technician,print_admin,media_admin

# Keycloak / Auth.js
AUTH_SECRET=change-me
NEXTAUTH_SECRET=change-me
KEYCLOAK_ISSUER=https://auth.example.com/realms/website
KEYCLOAK_CLIENT_ID=website
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_REQUIRED_MEDIA_ROLES=owner,media_admin
KEYCLOAK_ROLE_CLAIM_PATH=resource_access.website.roles
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=website-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Optional app-level Google provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External OpenBao
BAO_ADDR=https://openbao.internal.example.com
BAO_KV_MOUNT=kv
BAO_SECRET_PATH_WEBSITE=website/prod
BAO_SECRET_PATH_RUSTFS=rustfs/prod
BAO_SECRET_PATH_OAUTH2_PROXY=oauth2-proxy/prod
BAO_SECRET_PATH_KEYCLOAK=keycloak/prod
BAO_SECRET_PATH_SUPABASE=supabase/prod

# Deployment
DEPLOY_HOST=example-vps
DEPLOY_USER=deploy
DEPLOY_PATH=/srv/website
WEBSITE_IMAGE=ghcr.io/owner/repo-website:latest

# OAuth2 Proxy
OAUTH2_PROXY_CLIENT_ID=oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=change-me
OAUTH2_PROXY_COOKIE_SECRET=32-byte-cookie-secret-here!!
OAUTH2_PROXY_ALLOWED_ROLE=infra_admin
OAUTH2_PROXY_REDIRECT_URL=https://oauth2.example.com/oauth2/callback

# Compatibility / legacy
ALLOWED_EMAILS=
